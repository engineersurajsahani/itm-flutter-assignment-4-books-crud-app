# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Admin SDK Configuration
# Option 1: Path to your Firebase service account key JSON file
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Option 2: Direct environment variables (alternative to key file)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email@project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Set to true if you want to use in-memory mock database before setting up Firebase credentials
USE_MOCK_DB=false
